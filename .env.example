# KBOS — environment configuration
# Copy to .env and edit before starting:
#   cp .env.example .env
#   sed -i "s/DOCKER_UID=.*/DOCKER_UID=$(id -u)/; s/DOCKER_GID=.*/DOCKER_GID=$(id -g)/" .env

# ── Host user/group ───────────────────────────────────────────────────────────
# Run `id -u` and `id -g` on the host to get these values.
# Files inside the vault will be owned by this UID:GID.
DOCKER_UID=1000
DOCKER_GID=1000

# ── Vault paths ───────────────────────────────────────────────────────────────
# Absolute or relative path to your primary vault directory on the host.
VAULT_PATH=./vault

# Directory that houses additional vaults (multi-vault feature).
VAULTS_BASE=./vaults

# ── Web UI port ───────────────────────────────────────────────────────────────
# Host port the KBOS web UI is exposed on.
KBOS_PORT=3000

# ── Optional vault sync (docker-compose.sync.yml / ./manage.sh sync:up) ───────
# Syncthing UI and listen ports on the host. Config lives outside the vault.
# SYNCTHING_CONFIG=./.syncthing
# SYNCTHING_UI_PORT=8384
# SYNCTHING_SYNC_PORT=22000

# ── Optional RAG sidecar (docker-compose.rag.yml / ./manage.sh rag:up) ────────
# CPU-only Ollama for vault Q&A. Point Admin → AI at:
#   http://kbos-ollama:11434/v1   (from inside the KBOS container)
#   http://127.0.0.1:11434/v1    (from the host)
# OLLAMA_DATA=./.ollama
# OLLAMA_PORT=11434
# RAG_CHAT_MODEL=qwen2.5:1.5b
# RAG_EMBED_MODEL=nomic-embed-text
